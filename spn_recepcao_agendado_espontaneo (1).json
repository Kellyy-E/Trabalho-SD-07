  "rewardMeasures": [
    {
      "name": "U",
      "expression": "((N - E{#Atendentes}) / N) * 100",
      "id": "rm0"
    },
    {
      "name": "DP",
      "expression": "P{#Vagas = 0} * 100",
      "id": "rm1"
    },
    {
      "name": "TP",
      "expression": "E{#EmAtend_A} / D_AGENDADO + E{#EmAtend_E} / D_ESPONTANEO",
      "id": "rm2"
    },
    {
      "name": "TP_ESPERADA",
      "expression": "(1 / ATRASO_CHEGADA_TOTAL) * (1 - P{#Vagas = 0})",
      "id": "rm3"
    },
    {
      "name": "MQT_A",
      "expression": "IF E{#EmAtend_A} > 0 THEN E{#Fila_A} * D_AGENDADO / E{#EmAtend_A} ELSE 0",
      "id": "rm4"
    },
    {
      "name": "MQT_E",
      "expression": "IF E{#EmAtend_E} > 0 THEN E{#Fila_E} * D_ESPONTANEO / E{#EmAtend_E} ELSE 0",
      "id": "rm5"
    },
    {
      "name": "MQT",
      "expression": "IF E{#EmAtend_A} + E{#EmAtend_E} > 0 THEN (E{#Fila_A} + E{#Fila_E}) / (E{#EmAtend_A} / D_AGENDADO + E{#EmAtend_E} / D_ESPONTANEO) ELSE 0",
      "id": "rm6"
    },
    {
      "name": "MRT_A",
      "expression": "IF E{#EmAtend_A} > 0 THEN (E{#Fila_A} + E{#EmAtend_A}) * D_AGENDADO / E{#EmAtend_A} ELSE 0",
      "id": "rm7"
    },
    {
      "name": "MRT_E",
      "expression": "IF E{#EmAtend_E} > 0 THEN (E{#Fila_E} + E{#Cad_E} + E{#EmAtend_E}) * D_ESPONTANEO / E{#EmAtend_E} ELSE 0",
      "id": "rm8"
    }
  ],
